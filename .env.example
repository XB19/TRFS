# Used by docker-compose.yml. Copy to .env and fill in your own values —
# .env is gitignored, never commit real secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=trfs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

VITE_API_URL=http://localhost:8000

# Creates YOUR OWN admin account on first boot (python manage.py
# createsuperuser --noinput). Leave unset to skip and create one manually
# instead: docker compose exec backend python manage.py createsuperuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Bon Plan API: the connection link from the Bon Plan admin (Sites → this site → Connexion du site).
# Empty = this site keeps its own local content.
VITE_BONPLAN_URL=
