# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored — never commit real secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — must match a database you have created locally (or the `db`
# service in docker-compose.yml).
POSTGRES_DB=trfs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Origins allowed to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Used only by the Docker entrypoint to create YOUR OWN admin account on
# first boot (python manage.py createsuperuser --noinput). Leave unset to
# skip and create one manually instead — see README.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
